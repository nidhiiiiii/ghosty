# Public reads / frontend
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_EXTRUCTION_ADDRESS=

# Local browser relay and CLI (never commit real private keys)
LOCAL_RPC_URL=http://127.0.0.1:8545
RPC_URL=http://127.0.0.1:8545
VAULT=
EXTRUCTION_TARGET=
MAKER_ADDRESS=
MAKER_PRIVATE_KEY=
TAKER_ADDRESS=
TAKER_PRIVATE_KEY=

# Strategy controls
ROUTER_LAYOUT=deployed
SPREAD_BPS=15
BOUND_BPS=100
SHARE_LIQUIDITY=100
ASSET_LIQUIDITY=1000
DIRECTION=shares-to-asset
AMOUNT=1

# Only set for a production taker EOA that actually holds the Aqua resolver NFT.
I_HAVE_AQUA_RESOLVER_CREDENTIAL=false
